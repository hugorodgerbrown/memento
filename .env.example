# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://memento:memento@localhost:5432/memento

# Pocket webhook signing secret (Pocket app > Settings > Integrations > Webhooks)
POCKET_WEBHOOK_SECRET=

# Production also needs:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://memento.example.com
