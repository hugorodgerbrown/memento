# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://memento:memento@localhost:5432/memento
# Memento's Postgres port on this Mac. Change it if another Postgres already uses 5432
# ("port is already allocated"), and change the port in DATABASE_URL to match.
MEMENTO_DB_PORT=5432

# Pocket webhook signing secret (Pocket app > Settings > Integrations > Webhooks)
POCKET_WEBHOOK_SECRET=

# Pocket pull while Memento runs on one Mac (docs/local.md, ADR 0021):
# Pocket app > Settings > Developer > API Keys
POCKET_API_KEY=

# On Render none of the below are needed: render.yaml sets DJANGO_DEBUG=0 and
# generates DJANGO_SECRET_KEY, and settings.py trusts RENDER_EXTERNAL_HOSTNAME
# for both ALLOWED_HOSTS and CSRF. Set these only for a custom domain or another
# host. See docs/deploy.md.
# DJANGO_ALLOWED_HOSTS=memento.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://memento.example.com
# DJANGO_SECURE_SSL_REDIRECT=1
# LOG_LEVEL=INFO
