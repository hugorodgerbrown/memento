<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pull Pocket recordings into Memento every 15 minutes while the Mac is awake (0021).
  Installed by `make launchd-install LAUNCHD_JOBS=pocket`. It runs `make pocket-pull`,
  which reads POCKET_API_KEY from .env and looks back 36 hours, so a night asleep
  loses nothing and repeats are silent.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.memento.pocket</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/make</string><string>-C</string><string>@REPO@</string><string>pocket-pull</string></array>
  <key>WorkingDirectory</key><string>@REPO@</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>@PATH@</string></dict>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>@LOGS@/pocket.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/pocket.log</string>
</dict>
</plist>
